{
  "name": "the-backing-track-app",
  "version": "1.2.0",
  "description": "A practice app with a generated piano, bass and drum band that follows your chord changes.",
  "main": "main.js",
  "author": "The Backing Track App contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.backingtrack.desktop",
    "productName": "The Backing Track App",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "app/**/*"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "category": "public.app-category.music", "target": ["dmg"] },
    "linux": { "target": ["AppImage"], "category": "Audio" }
  }
}
